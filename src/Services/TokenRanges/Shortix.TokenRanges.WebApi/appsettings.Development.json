{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Shortix.TokenRange.WebApi"
    }
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ranges;Username=appuser;Password=apppassword"
  },
  "AllowedHosts": "*"
}