{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Shortix.Redirect.WebApi"
    }
  },
  "CosmosDb": {
    "DatabaseName": "",
    "ContainerName": "",
    "ConnectionString": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*"
}